POSTGRES_PASSWORD=replace-with-a-long-random-password
ADMIN_USERNAME=kalai
# Admin login password: 10+ characters
ADMIN_PASSWORD=replace-with-a-different-long-random-password

# Optional: enable Windows MT5 bridge login (7+ characters, separate from admin and broker login)
MT5_FEED_PASSWORD=

# Optional DEMO executor binding (0 disables claims; USD hedging demo only)
MT5_DEMO_ACCOUNT=0
MT5_DEMO_SERVER=OctaFX-Demo

# Signals do not require MT5; MT5 is the demo executor only.
KMR_PUBLIC_SIGNALS_ENABLED=true
# Optional v28 Low Profit route; broker fees must be confirmed separately.
KMR_PUBLIC_SCALPS_ENABLED=false
